{
  "redirects": [
    {
      "source": "/pricing",
      "destination": "/narxlar",
      "type": 301
    }
  ],
  "rewrites": [
    {
      "source": "/:path([^.].{0,})?",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "version.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "assets/**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": ".well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "directoryListing": false
}
